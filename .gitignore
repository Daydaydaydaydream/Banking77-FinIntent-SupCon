# -----------------------------------------------------------------------------
# Model caches, experiment trackers and training logs
# -----------------------------------------------------------------------------
.cache/
.huggingface/
huggingface/
wandb/
mlruns/
lightning_logs/
/runs/
events.out.tfevents.*

# Model/checkpoint files are large and reproducible from configs.
models/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
pytorch_model.bin

# -----------------------------------------------------------------------------
# Project-generated datasets
# -----------------------------------------------------------------------------
# The official source data under data/banking_data/ stays tracked. These files
# are deterministic derivatives produced by `python -m data.prepare_data`.
outputs/datasets/
outputs/datasets_dedup/

# -----------------------------------------------------------------------------
# EDA outputs
# -----------------------------------------------------------------------------
# Keep the report, statistics, workbook, figures and analysis tables.
# Ignore only authoring previews and inspection/debug sidecars.
outputs/eda/previews/
outputs/eda/*.inspect.ndjson

# -----------------------------------------------------------------------------
# Training outputs
# -----------------------------------------------------------------------------
# Keep config.json, env.json, metrics.json, training_history.json and
# confusion_matrix.csv. Ignore large/redundant per-example and model artifacts.
outputs/runs/**/model/
outputs/runs/**/checkpoints/
outputs/runs/**/predictions.csv
outputs/runs/**/embeddings.npy
outputs/runs/**/embeddings.npz
outputs/runs/**/trainer_state.json
outputs/runs/**/optimizer.pt
outputs/runs/**/scheduler.pt

# Legacy/generated output locations
outputs/models/
outputs/analysis/
outputs/figures/
outputs/results/

# Generic temporary files inside outputs
outputs/**/*.tmp
outputs/**/*.log
